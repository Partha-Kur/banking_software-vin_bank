def p_strength_c(password):
    has_letter = False
    has_digit = False

    for ch in password:
        if ch.isalpha():
            has_letter = True
        elif ch.isdigit():
            has_digit = True

    if len(password) > 8 and has_letter and has_digit:
        print("Password is valid ✅")
        return 'safe'
    else:
        print("\nPassword is invalid ❌")
        print("Requirements: > 8 characters, at least 1 letter, at least 1 number\n")
        return 'weak'


