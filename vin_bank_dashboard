def bank_dashboard(username, account_data, bank_accounts):
    """Main menu loop with embedded loans, credit scores, cards, and plotting."""
    while True:
        print(f"\n==========================================")
        print(f"          WELCOME TO YOUR DASHBOARD, {username.upper()}!")
        print(f"==========================================")
        print(f"1. Account Summary & Credit Score")
        print(f"2. Deposit Money")
        print(f"3. Withdraw Money")
        print(f"4. Apply Annual Interest (5%)")
        print(f"5. Pay Monthly Maintenance Fee ($12)")
        print(f"6. Credit Card Menu")
        print(f"7. Take Out a Loan")
        print(f"8. Pay Off Outstanding Loan")
        print(f"9. Plot Financial Visual Chart")
        print(f"10. Exit Dashboard")

        choice = input("\nSelect an option (1-10): ").strip()

        # 1. SUMMARY & CREDIT SCORE
        if choice == "1":
            print(f"\n--- 📊 Full Financial Summary ---")
            print(f"Checking Balance:   ${account_data['balance']:.2f}")
            print(f"Total Deposited:    ${account_data['total_deposits']:.2f}")
            print(f"Interest Earned:    ${account_data['total_interest']:.2f}")
            print(f"Outstanding Loan:   ${account_data['loan_balance']:.2f}")
            print(f"Credit Score:       {account_data['credit_score']} / 850")
            print(f"Rewards Points:     {account_data['rewards_points']} pts")
            print(f"Credit Limit:       ${account_data['credit_limit']:.2f}")
            print(f"Credit Used:        ${account_data['credit_used']:.2f}")

        # 2. DEPOSIT
        elif choice == "2":
            try:
                amount = float(input("Enter amount to deposit: $"))
                if amount <= 0:
                    print("Deposit amount must be greater than zero.")
                else:
                    account_data['balance'] += amount
                    account_data['total_deposits'] += amount
                    earned_points = int(amount // 10)
                    account_data['rewards_points'] += earned_points
                    print(f"Successfully deposited ${amount:.2f}!")
                    print(f"🎉 You earned {earned_points} rewards points!")
            except ValueError:
                print("Invalid input! Please enter a numerical value.")

        # 3. WITHDRAW
        elif choice == "3":
            try:
                amount = float(input("Enter amount to withdraw: $"))
                if amount <= 0:
                    print("Withdrawal amount must be greater than zero.")
                elif amount > account_data['balance']:
                    print("❌ Insufficient funds in your account!")
                else:
                    account_data['balance'] -= amount
                    print(f"Successfully withdrew ${amount:.2f}!")
                    print(f"Remaining balance: ${account_data['balance']:.2f}")
            except ValueError:
                print("Invalid input! Please enter a numerical value.")

        # 4. ANNUAL INTEREST
        elif choice == "4":
            interest_rate = 0.05
            earned_interest = account_data['balance'] * interest_rate
            account_data['balance'] += earned_interest
            account_data['total_interest'] += earned_interest
            print(f"\n📈 Interest Applied (5% rate)!")
            print(f"Added ${earned_interest:.2f} to your account.")
            print(f"New Balance: ${account_data['balance']:.2f}")

        # 5. MAINTENANCE FEE
        elif choice == "5":
            fee = 12.00
            print(f"\n💳 Monthly Account Maintenance Fee: ${fee:.2f}")
            if account_data['balance'] >= fee:
                account_data['balance'] -= fee
                print(f"Fee paid. Remaining Balance: ${account_data['balance']:.2f}")
                adjust_credit_score(account_data, 5, "On-time account maintenance payment")
            else:
                print("❌ Insufficient funds to cover the maintenance fee!")
                adjust_credit_score(account_data, -15, "Missed account fee payment")

        # 6. CREDIT CARD MENU
        elif choice == "6":
            print("\n--- Credit Card Operations ---")
            print(f"Available Credit: ${account_data['credit_limit'] - account_data['credit_used']:.2f}")
            print("1. Make a purchase with Credit Card")
            print("2. Pay off Credit Card balance")

            sub_choice = input("Select an option (1-2): ").strip()

            if sub_choice == "1":
                try:
                    spend = float(input("Enter purchase amount: $"))
                    available_credit = account_data['credit_limit'] - account_data['credit_used']
                    if spend <= 0:
                        print("Amount must be positive.")
                    elif spend > available_credit:
                        print("❌ Transaction declined: Exceeds credit limit!")
                    else:
                        account_data['credit_used'] += spend
                        cc_points = int(spend * 2)
                        account_data['rewards_points'] += cc_points
                        print(f"Transaction approved! ${spend:.2f} charged to Credit Card.")
                        print(f"🎉 Earned {cc_points} bonus reward points!")

                        if account_data['credit_limit'] > 0 and (account_data['credit_used'] / account_data['credit_limit']) > 0.8:
                            adjust_credit_score(account_data, -10, "High credit card utilization (>80%)")
                except ValueError:
                    print("Invalid input!")

            elif sub_choice == "2":
                try:
                    pay = float(input("Enter payment amount: $"))
                    if pay <= 0:
                        print("Amount must be positive.")
                    elif pay > account_data['balance']:
                        print("❌ Insufficient funds in bank balance to make this payment!")
                    elif pay > account_data['credit_used']:
                        print(f"You only owe ${account_data['credit_used']:.2f}.")
                    else:
                        account_data['balance'] -= pay
                        account_data['credit_used'] -= pay
                        print(f"Paid ${pay:.2f} towards credit card. Remaining owed: ${account_data['credit_used']:.2f}")
                        adjust_credit_score(account_data, 10, "Credit card payment")
                except ValueError:
                    print("Invalid input!")

        # 7. TAKE A LOAN
        elif choice == "7":
            print("\n--- 🏛️ Vin Bank Loan Center ---")
            score = account_data['credit_score']

            if score < 580:
                print(f"❌ Loan Application Rejected. Credit Score ({score}) is too low. Required: 580+")
            else:
                max_loan = (score - 500) * 20
                print(f"Credit Score: {score}")
                print(f"You qualify for up to: ${max_loan:.2f}")

                try:
                    loan_req = float(input("Enter requested loan amount: $"))
                    if loan_req <= 0:
                        print("Loan amount must be greater than zero.")
                    elif loan_req > max_loan:
                        print(f"❌ Request exceeds maximum approved limit of ${max_loan:.2f}.")
                    else:
                        loan_with_interest = loan_req * 1.05
                        account_data['balance'] += loan_req
                        account_data['loan_balance'] += loan_with_interest
                        print(f"🎉 Loan Approved! ${loan_req:.2f} deposited into your checking account.")
                        print(f"Total loan balance to repay (includes 5% interest): ${account_data['loan_balance']:.2f}")
                        adjust_credit_score(account_data, -5, "New loan account opened")
                except ValueError:
                    print("Invalid input!")

        # 8. PAY OFF LOAN
        elif choice == "8":
            print("\n--- 💸 Loan Repayment ---")
            if account_data['loan_balance'] == 0:
                print("You currently have no active loans to pay back!")
            else:
                print(f"Total Outstanding Loan Balance: ${account_data['loan_balance']:.2f}")
                print(f"Available Checking Balance:    ${account_data['balance']:.2f}")
                try:
                    pay = float(input("Enter loan repayment amount: $"))
                    if pay <= 0:
                        print("Amount must be positive.")
                    elif pay > account_data['balance']:
                        print("❌ Insufficient funds in checking balance!")
                    elif pay > account_data['loan_balance']:
                        print(f"You only owe ${account_data['loan_balance']:.2f}.")
                    else:
                        account_data['balance'] -= pay
                        account_data['loan_balance'] -= pay
                        print(f"Successfully repaid ${pay:.2f} toward your loan!")
                        print(f"Remaining loan balance: ${account_data['loan_balance']:.2f}")

                        adjust_credit_score(account_data, 15, "Loan repayment made")

                        if account_data['loan_balance'] == 0:
                            print("🎉 Congratulations! You have fully paid off your loan!")
                            adjust_credit_score(account_data, 25, "Loan fully paid off")
                except ValueError:
                    print("Invalid input!")

        # 9. VISUAL PLOT / CHART
        elif choice == "9":
            plot_financial_summary(account_data)

        # 10. EXIT
        elif choice == "10":
            # Save any changes made during the session
            save_accounts(bank_accounts)
            print("\n📁 Account info saved to 'bank_accounts.txt'!")
            print("Thank you for banking with Vin Bank! Goodbye! 👋")
            break
        else:
            print("Invalid choice! Please pick an option from 1 to 10.")
